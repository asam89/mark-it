# Use this config BEFORE obtaining TLS certificates.
# Rename to default.conf to use:
#   cp default-http-only.conf.template default.conf
#
# After running ssl-init.sh, switch back to the TLS-enabled default.conf.

server {
    listen 80;
    server_name mark-it.io www.mark-it.io;

    # Let's Encrypt verification
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Proxy to app (HTTP only — for initial cert setup)
    location / {
        proxy_pass http://app:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
