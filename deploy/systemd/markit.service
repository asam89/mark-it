[Unit]
Description=Mark-It Marketing Platform (Docker Compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mark-it
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --build app
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
